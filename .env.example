# Azure Monitor Lab - Environment Configuration
# Copy this file to .env and update with your values

# Azure Subscription and Tenant
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Resource Group Configuration
AZURE_RESOURCE_GROUP=rg-azuremonitorlab
AZURE_LOCATION=eastus
CREATE_RESOURCE_GROUP=true  # Set to false to use an existing resource group

# Environment Configuration
ENVIRONMENT_NAME=monitorlab  # Prefix for all resources (3-10 chars, lowercase alphanumeric)

# Publisher Configuration
PUBLISHER_EMAIL=your-email@example.com  # Email for API Management and alert notifications
PUBLISHER_NAME=Azure Monitor Lab  # Organization name for API Management

# Log Analytics Configuration
LOG_ANALYTICS_RETENTION_DAYS=30  # Data retention period (30-730 days)

# Optional: Set to true to enable verbose logging during deployment
VERBOSE=false
